# AI Help Desk Triage & Remediation Agent -- environment template.
#
# Copy this file to `.env` and fill in the values you need:
#
#   cp .env.example .env
#
# `.env` is in `.gitignore`: never commit a real credential.
# Every value below is a PLACEHOLDER: the demo runs without any of them.
#
# NOTE: the real connectors refuse to write anything unless
# HELPDESK_ALLOW_WRITES is exactly "1" (the kill switch).

# --------------------------------------------------------------------------- #
# Adapter selection (default: mock for every connector)
# --------------------------------------------------------------------------- #
HELPDESK_ITSM_ADAPTER=mock
HELPDESK_IDENTITY_ADAPTER=mock
HELPDESK_APP_ADAPTER=mock

# --------------------------------------------------------------------------- #
# Kill switch: writes to a real system are only allowed when this is "1".
# Keep it at 0 while exploring the repository.
# --------------------------------------------------------------------------- #
HELPDESK_ALLOW_WRITES=0

# --------------------------------------------------------------------------- #
# ServiceNow (optional) -- https://yourcompany.service-now.com
# --------------------------------------------------------------------------- #
# SERVICENOW_INSTANCE=yourcompany
# SERVICENOW_USERNAME=your.service.account@example.com
# SERVICENOW_PASSWORD=your-password
# SERVICENOW_ACCESS_TOKEN=your-rest-token

# --------------------------------------------------------------------------- #
# Jira Service Management (optional) -- API token, never the password.
# --------------------------------------------------------------------------- #
# JIRA_URL=https://yourcompany.atlassian.net
# JIRA_EMAIL=your.service.account@example.com
# JIRA_API_TOKEN=your-api-token
# JIRA_PROJECT_KEY=ITSM

# --------------------------------------------------------------------------- #
# Microsoft Entra ID / Graph (optional)
# --------------------------------------------------------------------------- #
# ENTRA_TENANT_ID=your-tenant-id
# ENTRA_CLIENT_ID=your-client-id
# ENTRA_CLIENT_SECRET=your-client-secret
# ENTRA_ACCESS_TOKEN=your-graph-access-token
# GRAPH_BASE_URL=https://graph.microsoft.com/v1.0

# --------------------------------------------------------------------------- #
# Laboratorio agentic (Fase 00+) — configuración central (config.py)
# --------------------------------------------------------------------------- #
# LAB_MOCK_MODE=1
# LAB_LLM_PROVIDER=mock
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# LAB_LLM_MODEL=mock-deterministic
# LAB_LLM_MAX_TOKENS=512
# LAB_CHROMA_PATH=outputs/chroma
# LAB_EMBEDDING_MODEL=mock
# LAB_API_HOST=127.0.0.1
# LAB_API_PORT=8000
# LAB_STT_PROVIDER=mock
# LAB_TTS_PROVIDER=mock
# LAB_LOG_LEVEL=INFO
# --------------------------------------------------------------------------- #
# Okta (optional)
# --------------------------------------------------------------------------- #
# OKTA_ORG=yourcompany
# OKTA_API_TOKEN=your-okta-api-token
# OKTA_BASE_URL=https://yourcompany.okta.com/api/v1
